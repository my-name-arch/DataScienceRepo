  year = {2021},
  doi = {10.1177/0020294019858101},
  note = {This study applies a support vector machine approach to predict the reliability of future transit service. It is a useful peer-reviewed example of using machine learning for transit reliability, although the methods and data may be specific to the service system examined by the authors. This source gives me one possible modeling approach and reinforces the idea that accurate reliability information can help riders make better travel decisions.}
}

@article{moosavi2023,
  author = {Moosavi, S. M. H. and others},
