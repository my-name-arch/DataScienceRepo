}

@article{rum2024,
  author = {Rum, Siti Nurulain Mohd and Yusoff, Meor Muhammad Nazmi Meor and Mahdi, Amalia},
  title = {Public Transport Delay Prediction Using Deep Learning},
  journal = {Journal of Advanced Research in Applied Sciences and Engineering Technology},
  volume = {59},
  number = {1},
  pages = {1--10},
  year = {2024},
  note = {This article uses a deep-learning model to predict public-transport delays using transit and weather-related information. It is helpful as a recent example of a prediction-focused study, but deep-learning results can be harder to interpret and may require more data than a class project has available. This source helps me consider weather and other external variables while also reminding me to compare complex models with simpler and more interpretable methods.}
}

@article{lomax2002,
  author = {Lomax, Tim and others},
  title = {Using Travel Time Measures to Estimate Mobility and Reliability},
  institution = {Federal Highway Administration and Bureau of Transportation Statistics},
  year = {2002},
  note = {This report explains how travel-time measures can be used to evaluate mobility and reliability in transportation systems. It is an older government report rather than a recent peer-reviewed article, but it is useful for defining reliability and identifying common sources of travel-time variation. This source provides background for why average travel time alone is not enough to describe the rider experience.}
}

@report{fosgerau2010,
  author = {Fosgerau, Mogens and others},
  title = {The Valuation of Travel Time Variability},
  institution = {International Transport Forum, Organisation for Economic Co-operation and Development},
  year = {2010},
  note = {This report discusses why travelers value predictable travel times and may experience costs from uncertainty even when average trip time does not change. It is a credible policy-oriented source, although it is broader than public transit and does not focus on a specific local community. This source helps explain why predicting delay can be valuable to riders, agencies, and planners even if a prediction does not directly remove the delay.}
}

